<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Faltaba desde el scaffold inicial (Fase 0) — sin este permiso CUALQUIER llamada
         de red (Supabase, backend Next.js) falla con "Failed host lookup" para
         cualquier hostname, sin importar el DNS/red del dispositivo. Causa raíz real
         del bug de pantalla en blanco + fallos de red investigados en la Fase 2. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Fase 1: geolocator (location_provider.dart). Fase 0 ya pide notification vía
         permission_handler — POST_NOTIFICATIONS también debe declararse aquí para
         Android 13+, o la solicitud de permiso simplemente no aparece. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fase 2: RecorderController (cámara/mic) + foreground service para que la
         grabación/ubicación del SOS sobrevivan con la app en segundo plano. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Fase 4: SosAlarm (platform/sos_alarm.dart) — patrón de vibración al activar SOS
         y al aviso de 5 minutos del temporizador de seguridad. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Gesto de SOS por botón de volumen con la pantalla apagada
         (VolumeSosService.kt). SPECIAL_USE es el tipo de foreground service que
         corresponde: el servicio no reproduce medios ni graba, solo mantiene
         viva la detección de un gesto de emergencia. WAKE_LOCK despierta el
         proceso al disparar; USE_FULL_SCREEN_INTENT abre la app sobre la
         pantalla de bloqueo; RECEIVE_BOOT_COMPLETED lo revive tras reiniciar. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Sin la exención de optimización de batería, Android puede congelar el
         proceso tras un rato con la pantalla apagada y el gesto deja de
         responder. Se pide desde Ajustes, nunca de forma automática. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <application
        android:label="SOSecure"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Trabajo opcional #6 (TRABAJOS_OPCIONALES.md): captura el link de
                 confirmación de registro/reset de PIN cuando el usuario se registró
                 desde la app, para que abra la app en vez del navegador.
                 supabase_flutter ya escucha deep links automáticamente (PKCE) y
                 completa la sesión al recibir esta URI — no hace falta código extra
                 de manejo, solo que Android lo enrute aquí. Esquema custom (no
                 requiere verificación de dominio como los App Links https). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="sosecure" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <service
            android:name=".VolumeSosService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detección continua del gesto de emergencia (pulsaciones del botón de volumen) con la pantalla apagada, para activar una alerta SOS sin desbloquear el teléfono." />
        </service>
        <!-- Sin directBootAware: las preferencias donde vive la configuración
             del gesto están en almacenamiento cifrado con credenciales, que no
             existe hasta el primer desbloqueo tras encender el teléfono. -->
        <receiver
            android:name=".VolumeSosBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Requerido por url_launcher (package visibility de Android 11+) para
             encontrar un navegador al abrir el pago de Premium/Plan Familiar -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Requerido por speech_to_text (paquete usado por voice_sos_provider.dart)
             con targetSdk 30+: sin esto, el plugin no puede DESCUBRIR el servicio de
             reconocimiento de voz del sistema por package visibility (Android 11+) —
             initialize()/listen() no lanzan error, simplemente no hay ningún
             reconocedor disponible para bindear, así que la palabra clave nunca se
             detecta aunque el permiso de micrófono ya esté concedido. Ver el README
             del paquete, sección "Android SDK 30 or later". -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
